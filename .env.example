# ─────────────────────────────────────────────────────────────────────────────
# Jarvas Image Captioning AI — environment configuration
# Copy this file to `.env` and adjust the values. Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Leave EMPTY to run in Demo Mode (curated sample captions, no backend needed).
# Example for a local FastAPI server:  http://127.0.0.1:8000
VITE_API_BASE_URL=

# Endpoint that accepts multipart/form-data with an `image` field.
VITE_API_CAPTION_PATH=/api/caption

# Force Demo Mode on/off. Auto-detected from VITE_API_BASE_URL when unset.
#   true  -> always use sample responses
#   false -> always call the API (errors are surfaced, no silent fallback)
VITE_DEMO_MODE=

# Abort the caption request after this many milliseconds.
VITE_API_TIMEOUT_MS=30000

# Uploader limits.
VITE_MAX_FILE_SIZE_MB=10

# Dev server
VITE_DEV_PORT=5173
# Target used by the Vite dev proxy for /api requests (avoids CORS locally).
VITE_PROXY_TARGET=http://127.0.0.1:8000

# ── Placeholder profile links — replace with your real URLs ──────────────────
VITE_GITHUB_URL=https://github.com/your-username/jarvas-image-captioning-ai
VITE_LINKEDIN_URL=https://www.linkedin.com/in/your-username/

VITE_APP_VERSION=1.0.0
